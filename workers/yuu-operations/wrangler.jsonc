{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuu-operations",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [{ "name": "PAYMENT_INTENTS", "class_name": "PaymentIntentObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PaymentIntentObject"] }],
  "queues": {
    "producers": [{ "binding": "NOTIFICATIONS", "queue": "yuu-notifications" }],
    "consumers": [{
      "queue": "yuu-notifications",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 10,
      "dead_letter_queue": "yuu-notifications-dlq"
    }]
  }
}
